---
import { getImage } from 'astro:assets';
import contactImage from '../assets/Image02.jpg';

const bg = await getImage({ src: contactImage, width: 1920, format: 'webp', quality: 60 });

const socials = [
  { href: 'http://wa.me/+573193054761', label: 'WhatsApp', icon: 'fa-brands fa-whatsapp' },
  { href: 'https://www.facebook.com/vivamexicolindorestaurante', label: 'Facebook', icon: 'fa-brands fa-facebook-f' },
  { href: 'https://www.instagram.com/padrisimo_restaurante_mzl/', label: 'Instagram', icon: 'fa-brands fa-instagram' },
];
---

<section class="CONTACT" id="contacto" style={`--bg-image: url('${bg.src}')`}>
  <h2>CONTÁCTANOS</h2>
  <div class="CONTAINER">
    <iframe
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d993.578318206585!2d-75.4897819014739!3d5.052872803263714!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8e47657a5762f22f%3A0xfc3e3354900425b4!2sPadr%C3%ADsimo%20Restaurante%20Mexicano!5e0!3m2!1ses-419!2sco!4v1653599012701!5m2!1ses-419!2sco"
      title="Ubicación de Padrísimo en Google Maps"
      allowfullscreen
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"></iframe>
    <div class="CONTACT__INFO">
      <div>
        <h3><i class="fa-regular fa-clock" aria-hidden="true"></i> Horarios</h3>
        <p>Lun a Vie: <span>10:00 am</span> hasta <span>11:00 pm</span></p>
        <p>Sáb a Dom: <span>10:00 am</span> hasta <span>01:00 am</span></p>
      </div>
      <div>
        <h3><i class="fa-solid fa-phone" aria-hidden="true"></i> Teléfono</h3>
        <a href="tel:+573193054761">319 305 4761</a>
      </div>
      <div>
        <h3><i class="fa-regular fa-envelope" aria-hidden="true"></i> Email</h3>
        <a href="mailto:sga4111@gmail.com">reservas@padrisimo.com</a>
      </div>
      <div>
        <h3>Redes sociales</h3>
        <div class="SOCIAL">
          {socials.map(({ href, label, icon }) => (
            <a href={href} target="_blank" rel="noopener noreferrer" aria-label={label}>
              <i class={icon} aria-hidden="true"></i>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
