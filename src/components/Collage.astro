---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const images = Object.values(
  import.meta.glob<{ default: ImageMetadata }>('../assets/collage/*.jpg', { eager: true })
).map((mod) => mod.default);
---

<section class="COLLAGE" id="galeria">
  <h2>IMÁGENES</h2>
  <div class="CONTAINER">
    {images.map((src) => (
      <Image
        src={src}
        alt="Comida mexicana"
        widths={[300, 600]}
        sizes="(min-width: 900px) 25vw, (min-width: 600px) 33vw, 50vw"
      />
    ))}
  </div>
</section>
